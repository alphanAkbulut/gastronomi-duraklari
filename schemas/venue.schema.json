            ]
          }
        }
      }
    },
    "ratings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "value",
          "scale_max",
          "review_count",
          "source_url",
          "observed_at",
          "verification_status"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "scale_max": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "review_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "source_url": {
            "type": "string"
          },
          "observed_at": {
            "type": "string"
          },
          "verification_status": {
            "enum": [
              "unverified",
              "verified",
              "needs_review"
            ]
          }
        }
      }
    },
    "dishes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "source_url",
          "observed_at",
          "verification_status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_url": {
            "type": "string"
          },
          "observed_at": {
            "type": "string"
          },
          "verification_status": {
