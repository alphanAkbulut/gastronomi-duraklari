    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "caption",
          "rights_status",
          "attribution",
          "source_url",
          "observed_at",
          "verification_status"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "caption": {
            "type": [
              "string",
              "null"
            ]
          },
          "rights_status": {
            "enum": [
              "unknown",
              "permission_granted",
              "licensed",
              "owned"
            ]
          },
          "attribution": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_url": {
            "type": "string"
          },
          "observed_at": {
            "type": "string"
          },
          "verification_status": {
            "enum": [
              "unverified",
              "verified",
              "needs_review"
            ]
          }
        }
      }
    },
    "videos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
