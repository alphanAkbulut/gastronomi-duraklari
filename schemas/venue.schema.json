{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lezzet venue v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "venue_id",
    "city_id",
    "name",
    "brand_id",
    "address",
    "coordinates",
    "operating_status",
    "publication_status",
    "source_records",
    "enrichment",
    "external_places",
    "websites",
    "social_accounts",
    "ratings",
    "dishes",
    "photos",
    "videos",
    "editorial_notes"
  ],
  "properties": {
    "venue_id": {
      "type": "string",
      "format": "uuid"
    },
    "city_id": {
      "type": "string",
      "pattern": "^tr-[a-z]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "brand_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw",
        "district",
        "neighborhood",
        "postal_code"
      ],
      "properties": {
        "raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "district": {
          "type": [
            "string",
            "null"
          ]
        },
        "neighborhood": {
          "type": [
            "string",
            "null"
          ]
        },
        "postal_code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "coordinates": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "latitude",
            "longitude",
            "source_url",
            "observed_at"
          ],
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "source_url": {
              "type": "string"
            },
            "observed_at": {
              "type": "string"
            }
          }
        }
      ]
    },
    "operating_status": {
      "enum": [
        "unknown",
        "open",
        "temporarily_closed",
        "permanently_closed"
      ]
    },
    "publication_status": {
      "enum": [
        "draft",
        "published",
        "archived"
      ]
    },
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "legacy_record_id",
          "listing_url",
          "observed_at",
          "name",
          "address"
        ]
      }
    },
    "enrichment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address_and_location",
        "operating_status",
        "google_match",
        "websites_and_social",
        "ratings",
        "dishes_and_editorial",
        "photos",
        "videos"
      ],
      "properties": {
        "address_and_location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "checked_at",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_started",
                "in_progress",
                "verified",
                "not_found",
                "needs_review",
                "failed"
              ]
            },
            "checked_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "operating_status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "checked_at",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_started",
                "in_progress",
                "verified",
                "not_found",
                "needs_review",
                "failed"
              ]
            },
            "checked_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "google_match": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "checked_at",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_started",
                "in_progress",
                "verified",
                "not_found",
                "needs_review",
                "failed"
              ]
            },
            "checked_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "websites_and_social": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "checked_at",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_started",
                "in_progress",
                "verified",
                "not_found",
                "needs_review",
                "failed"
              ]
            },
            "checked_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "ratings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "checked_at",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_started",
                "in_progress",
                "verified",
                "not_found",
                "needs_review",
                "failed"
              ]
            },
            "checked_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "dishes_and_editorial": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "checked_at",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_started",
                "in_progress",
                "verified",
                "not_found",
                "needs_review",
                "failed"
              ]
            },
            "checked_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "photos": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "checked_at",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_started",
                "in_progress",
                "verified",
                "not_found",
                "needs_review",
                "failed"
              ]
            },
            "checked_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "videos": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "checked_at",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_started",
                "in_progress",
                "verified",
                "not_found",
                "needs_review",
                "failed"
              ]
            },
            "checked_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "external_places": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "place_id",
          "url",
          "source_url",
          "observed_at",
          "verification_status"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "place_id": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_url": {
            "type": "string"
          },
          "observed_at": {
            "type": "string"
          },
          "verification_status": {
            "enum": [
              "unverified",
              "verified",
              "needs_review"
            ]
          }
        }
      }
    },
    "websites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "source_url",
          "observed_at",
          "verification_status"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "observed_at": {
            "type": "string"
          },
          "verification_status": {
            "enum": [
              "unverified",
              "verified",
              "needs_review"
            ]
          }
        }
      }
    },
    "social_accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "url",
          "source_url",
          "observed_at",
          "verification_status"
        ],
        "properties": {
          "platform": {
            "type": "string"
          },
          "url": {
