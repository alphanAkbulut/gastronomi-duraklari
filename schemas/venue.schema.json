          "author",
          "source_url",
          "observed_at",
          "verification_status"
        ],
        "properties": {
          "kind": {
            "enum": [
              "why_go",
              "what_to_order",
              "who_for",
              "caution"
            ]
          },
          "text": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "observed_at": {
            "type": "string"
          },
          "verification_status": {
            "enum": [
              "unverified",
